---
// A static top-to-bottom pipeline diagram for case studies; it reads the same at every width.
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<ol class="flow" aria-label="Pipeline">
  {steps.map((step, index) => (
    <li class="flow-step"><span class="flow-index">{String(index + 1).padStart(2, '0')}</span>{step}</li>
  ))}
</ol>

<style>
  .flow {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: .8rem;
  }

  .flow-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: .75rem;
    max-width: 100%;
    padding: .7rem .9rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }

  /* A short connector joins each step to the next. */
  .flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 1.45rem;
    width: 1px;
    height: 1.25rem;
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 25%, transparent));
  }

  .flow-index { color: var(--muted); }
</style>
