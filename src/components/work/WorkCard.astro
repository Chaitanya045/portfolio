---
import type { CollectionEntry } from 'astro:content';
import WorkCover from '@/components/work/WorkCover.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
  sizes: string;
  class?: string;
}

const { entry, index, sizes, class: className } = Astro.props;
const { title, kind, summary, period } = entry.data;
---

<article class:list={['work-card', className]} data-reveal>
  <a href={`/work/${entry.id}/`} class="work-link" data-cursor="View case study ↗">
    <WorkCover entry={entry} sizes={sizes} />
    <p class="kicker work-meta">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <span>{kind}</span>
      <span>{period.split(' – ')[0].split(' ')[1]}</span>
    </p>
    <h3 class="serif work-title" style={`view-transition-name: title-${entry.id}`}>{title}</h3>
    <p class="work-summary">{summary}</p>
    <span class="work-cta"><span class="work-cta-text">Read the case study</span> <span class="work-cta-arrow" aria-hidden="true">→</span></span>
  </a>
</article>

<style>
  .work-link { display: block; }

  /* Screenshots rest slightly dimmed on the dark page and light up on hover. */
  .work-link :global(.cover img),
  .work-link :global(.type-cover) { filter: brightness(.78) saturate(.9); transition: transform .9s var(--ease-out), filter .5s ease; }
  .work-link:hover :global(.cover img),
  .work-link:hover :global(.type-cover) { filter: none; transform: scale(1.03); }
  .work-link :global(.cover) { transition: border-color .4s ease; }
  .work-link:hover :global(.cover) { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .work-title { transition: color .3s ease; }
  .work-link:hover .work-title { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) { .work-link { cursor: none; } }

  .work-meta {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.1rem;
  }

  .work-meta span:first-child { color: var(--accent); }

  .work-title {
    width: fit-content;
    margin-top: .4rem;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1;
  }

  .work-summary {
    max-width: 34rem;
    margin-top: .6rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .work-cta {
    display: inline-flex;
    gap: .4rem;
    margin-top: 1rem;
    font-size: .875rem;
  }

  .work-cta-text {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 5px;
    transition: text-decoration-color .2s ease;
  }

  .work-cta-arrow { transition: transform .3s ease; }
  .work-link:hover .work-cta-text { text-decoration-color: currentColor; }
  .work-link:hover .work-cta-arrow { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .work-link :global(.cover img), .work-link :global(.type-cover), .work-cta-arrow { transition: none; }
    .work-link:hover :global(.cover img), .work-link:hover :global(.type-cover), .work-link:hover .work-cta-arrow { transform: none; }
    .work-link { cursor: pointer; }
  }
</style>
