<div class="hero-intro" aria-hidden="true">
  <div class="intro-shutter intro-shutter-top"></div>
  <div class="intro-shutter intro-shutter-bottom"></div>
  <div class="intro-glow"></div>
  <div class="intro-line" data-intro-line></div>
</div>

<style>
  .hero-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    overflow: hidden;
  }

  :global(html[data-intro='playing']) .hero-intro { display: block; }

  .intro-shutter {
    position: absolute;
    left: 0;
    width: 100%;
    height: calc(50% + 80px);
    will-change: transform, opacity;
    animation-duration: 1600ms;
    animation-timing-function: cubic-bezier(.4, 0, .2, 1);
    animation-fill-mode: both;
  }

  .intro-shutter-top {
    top: 0;
    background: linear-gradient(to bottom, var(--hero-shade) calc(100% - 80px), transparent);
    animation-name: ignition-open-top;
  }
  .intro-shutter-bottom {
    bottom: 0;
    background: linear-gradient(to top, var(--hero-shade) calc(100% - 80px), transparent);
    animation-name: ignition-open-bottom;
  }

  .intro-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--intro-glow) 34.90196078%, transparent), color-mix(in srgb, var(--hero-glow-start) 14.90196078%, transparent) 35%, transparent 70%);
    will-change: transform, opacity;
    animation: ignition-glow 1600ms cubic-bezier(.4, 0, .2, 1) both;
  }

  .intro-line {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-strong);
    box-shadow: 0 0 12px color-mix(in srgb, var(--intro-line-glow) 50.19607843%, transparent), 0 0 34px color-mix(in srgb, var(--intro-line-halo) 21.96078431%, transparent);
    transform-origin: center;
    will-change: transform, opacity;
    animation: ignition-line 1600ms cubic-bezier(.65, 0, .25, 1) both;
  }

  :global(html[data-intro='playing'] [data-intro-content]) {
    animation: ignition-content 1600ms ease-out both;
  }

  @keyframes ignition-line {
    0% { opacity: 0; transform: translateY(-50%) rotate(-90deg) scaleX(var(--intro-line-scale, .06)); }
    15%, 26% { opacity: 1; transform: translateY(-50%) rotate(-90deg) scaleX(var(--intro-line-scale, .06)); }
    46% { opacity: 1; transform: translateY(-50%) rotate(0deg) scaleX(var(--intro-line-scale, .06)); }
    58% { opacity: 1; filter: blur(0); transform: translateY(-50%) rotate(0deg) scaleX(1); }
    /* Dissolve the edge into the glow while the feathered reveal opens. */
    70%, 100% { opacity: 0; filter: blur(10px); transform: translateY(-50%) rotate(0deg) scale(1, 8); }
  }

  @keyframes ignition-glow {
    0%, 54% { opacity: 0; transform: scaleY(.015); }
    62% { opacity: .6; transform: scaleY(.12); }
    76% { opacity: .45; transform: scaleY(.7); }
    100% { opacity: 0; transform: scaleY(1); }
  }

  @keyframes ignition-open-top {
    0%, 58% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-101%); }
  }

  @keyframes ignition-open-bottom {
    0%, 58% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(101%); }
  }

  /* The content starts at a near-zero opacity rather than hidden: the shutters cover it either
     way, and browsers only count an element as the Largest Contentful Paint if it paints visibly. */
  @keyframes ignition-content {
    0%, 73% { opacity: .01; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-intro='playing']) .hero-intro { display: none; }
    :global(html[data-intro='playing'] [data-intro-content]) { animation: none; }
  }
</style>
