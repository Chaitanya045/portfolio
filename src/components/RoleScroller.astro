---
const roles = [
  'Software Engineer',
  'Full Stack Engineer',
  'Applied AI Engineer',
  'QA Automation Engineer',
];
---

<div class="role-scroller" data-role-scroller>
  <p class="sr-only">Roles: {roles.join(', ')}.</p>
  <div class="role-window" aria-hidden="true">
    <div class="role-track">
      {[...roles, roles[0]].map((role) => <span class="role-item">{role}</span>)}
    </div>
  </div>
</div>

<script>
  const scroller = document.querySelector<HTMLElement>('[data-role-scroller]');
  const syncVisibility = () => scroller?.toggleAttribute('data-hidden', document.hidden);
  syncVisibility();
  document.addEventListener('visibilitychange', syncVisibility);

  if (scroller) {
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const hero = scroller.closest<HTMLElement>('[data-hero]');
    let readingTimer: number | undefined;
    const stopReading = () => {
      clearTimeout(readingTimer);
      scroller.removeAttribute('data-reading');
    };
    scroller.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch' || !finePointer.matches || reducedMotion.matches) return;
      if (hero?.dataset.motion === 'paused' || document.documentElement.hasAttribute('data-intro')) return;
      const animation = scroller.querySelector('.role-track')?.getAnimations()[0];
      // Let an active slide finish naturally before holding a complete role.
      let delay = 0;
      if (animation && typeof animation.currentTime === 'number') {
        const phase = animation.currentTime % 4000;
        if (phase >= 3200) delay = 4000 - phase + 20;
      }
      clearTimeout(readingTimer);
      readingTimer = window.setTimeout(() => scroller.setAttribute('data-reading', ''), delay);
    });
    scroller.addEventListener('pointerleave', stopReading);
    scroller.addEventListener('pointercancel', stopReading);
    document.addEventListener('visibilitychange', stopReading);
    finePointer.addEventListener('change', stopReading);
    reducedMotion.addEventListener('change', stopReading);
    hero?.addEventListener('blaze:motionchange', stopReading);
  }
</script>

<style>
  .role-scroller {
    position: absolute;
    top: calc(100% + clamp(1rem, 2vw, 1.75rem));
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100vw - 48px), 40rem);
    color: #cfb3a4;
    font-family: 'Outfit', 'Segoe UI', sans-serif;
    font-size: clamp(.8rem, 1.1vw, 1rem);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: color .25s ease;
  }

  .role-window {
    height: 2.5em;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
  }

  .role-track {
    animation: roles-scroll 16s cubic-bezier(.65, 0, .35, 1) infinite;
  }

  .role-item {
    display: block;
    height: 2.5em;
    line-height: 2.5;
    white-space: nowrap;
  }

  /* Four readable holds and a duplicate first row make the loop seamless. */
  @keyframes roles-scroll {
    0%, 20% { transform: translateY(0); }
    25%, 45% { transform: translateY(-20%); }
    50%, 70% { transform: translateY(-40%); }
    75%, 95% { transform: translateY(-60%); }
    100% { transform: translateY(-80%); }
  }

  :global(html[data-intro='playing']) .role-track,
  :global([data-hero][data-motion='paused']) .role-track,
  .role-scroller[data-hidden] .role-track {
    animation-play-state: paused;
  }

  .role-scroller[data-reading] { color: #f0c5ad; }
  .role-scroller[data-reading] .role-track { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .role-track { animation: none; }
    .role-scroller { transition: none; }
  }
</style>
