---
const roles = [
  'Software Engineer',
  'Full Stack Engineer',
  'Applied AI Engineer',
  'Test Automation Engineer',
];
---

<div class="role-scroller" data-role-scroller>
  <p class="sr-only">Roles: {roles.join(', ')}.</p>
  <div class="role-window" aria-hidden="true">
    <div class="role-track">
      {[...roles, roles[0]].map((role) => <span class="role-item">{role}</span>)}
    </div>
  </div>
</div>

<script>
  const scroller = document.querySelector<HTMLElement>('[data-role-scroller]');
  const syncVisibility = () => scroller?.toggleAttribute('data-hidden', document.hidden);
  syncVisibility();
  document.addEventListener('visibilitychange', syncVisibility);
</script>

<style>
  .role-scroller {
    position: absolute;
    top: calc(100% + clamp(1rem, 2vw, 1.75rem));
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100vw - 48px), 40rem);
    color: #cfb3a4;
    font-family: 'Outfit', 'Segoe UI', sans-serif;
    font-size: clamp(.8rem, 1.1vw, 1rem);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .role-window {
    height: 2.5em;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
  }

  .role-track {
    animation: roles-scroll 16s cubic-bezier(.65, 0, .35, 1) infinite;
  }

  .role-item {
    display: block;
    height: 2.5em;
    line-height: 2.5;
    white-space: nowrap;
  }

  /* Four readable holds and a duplicate first row make the loop seamless. */
  @keyframes roles-scroll {
    0%, 20% { transform: translateY(0); }
    25%, 45% { transform: translateY(-20%); }
    50%, 70% { transform: translateY(-40%); }
    75%, 95% { transform: translateY(-60%); }
    100% { transform: translateY(-80%); }
  }

  :global(html[data-intro='playing']) .role-track,
  :global([data-hero][data-motion='paused']) .role-track,
  .role-scroller[data-hidden] .role-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .role-track { animation: none; }
  }
</style>
