---
import { experience } from '@/data/resume';
---

<section id="experience" class="experience wrap" aria-labelledby="experience-title">
  <div class="section-head">
    <h2 id="experience-title" class="serif section-title" data-reveal="title"><span>Experience</span></h2>
    <span class="kicker">2022 — now</span>
  </div>
  <ol class="ledger">
    {experience.map((job) => (
      <li class="ledger-row" data-reveal>
        <p class="kicker ledger-when">{job.start} — {job.end}</p>
        <div>
          <h3 class="serif ledger-company">{job.company}</h3>
          <p class="ledger-role">{job.role} · {job.location}</p>
        </div>
        <div>
          <ul class="ledger-points">
            {job.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <p class="kicker ledger-tech">{job.tech.join(' · ')}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience { padding-bottom: clamp(4rem, 9vw, 7rem); }

  .ledger {
    position: relative;
    z-index: 0;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ledger-row {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }

  /* Hovering a row sweeps a faint panel in from the left and nudges the company forward. */
  .ledger-row::before {
    content: '';
    position: absolute;
    inset: 0 -1.5rem;
    z-index: -1;
    background: linear-gradient(90deg, var(--surface), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .6s var(--ease-out);
  }

  .ledger-row:hover::before { transform: scaleX(1); }
  .ledger-company { transition: transform .5s var(--ease-out), color .3s ease; }
  .ledger-row:hover .ledger-company { color: var(--accent); transform: translateX(6px); }
  .ledger-points li::before { transition: width .4s var(--ease-out); }
  .ledger-row:hover .ledger-points li::before { width: .8rem; }

  @media (prefers-reduced-motion: reduce) {
    .ledger-row::before, .ledger-company, .ledger-points li::before { transition: none; }
    .ledger-row:hover .ledger-company { transform: none; }
  }

  @media (min-width: 56rem) {
    .ledger-row { grid-template-columns: 10rem 16rem 1fr; gap: 2rem; }
  }

  .ledger-when { padding-top: .5rem; }

  .ledger-company {
    font-size: 2rem;
    line-height: 1.05;
  }

  .ledger-role {
    margin-top: .35rem;
    color: var(--muted);
    font-size: .95rem;
  }

  .ledger-points {
    display: grid;
    gap: .6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.6;
  }

  .ledger-points li {
    position: relative;
    padding-left: 1.1rem;
  }

  .ledger-points li::before {
    content: '';
    position: absolute;
    top: .75em;
    left: 0;
    width: .45rem;
    height: 1px;
    background: var(--accent);
  }

  .ledger-tech { margin-top: 1.1rem; }
</style>
