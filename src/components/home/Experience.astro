---
import { experience, jobId } from '@/data/resume';
---

<section id="experience" class="experience wrap" aria-labelledby="experience-title">
  <h2 id="experience-title" class="prompt-title">~/experience <small>{String(experience.length).padStart(2, '0')} roles</small></h2>
  {experience.map((job) => (
    <article class="job" id={jobId(job.company)} data-reveal>
      <div class="job-head">
        <h3 class="display job-company">{job.company}</h3>
        <p class="job-when">{job.start} – {job.end}</p>
      </div>
      <p class="job-role">{job.role} <span>· {job.location}</span></p>
      <ul class="job-points">
        {job.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
      <p class="job-tech">{job.tech.join(' / ')}</p>
    </article>
  ))}
</section>

<style>
  .experience { padding-top: clamp(5rem, 9vw, 6.5rem); }

  .job { margin-top: 3.5rem; }

  .job + .job { margin-top: 5rem; }

  .job-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .job-company { font-size: clamp(1.9rem, 3.5vw, 2.6rem); line-height: 1.05; }

  .job-when { flex: none; color: var(--muted); font-size: .875rem; }

  .job-role { margin-top: .9rem; color: var(--accent); font-size: .875rem; }
  .job-role span { color: var(--muted); }

  .job-points {
    max-width: 55rem;
    margin: 1.75rem 0 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .job-points li {
    margin: .9rem 0;
    padding-left: .6rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .job-points li::marker { color: var(--accent); font-size: .65em; }

  .job-tech { margin-top: 1.5rem; color: var(--muted); font-size: .8125rem; }

  @media (max-width: 44rem) {
    .job-head { display: block; }
    .job-when { margin-top: .6rem; }
    .job-points { padding-left: .9rem; }
    .job-points li { font-size: 1rem; padding-left: .3rem; }
  }
</style>
