---
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="projects wrap" aria-labelledby="work-title" data-projects>
  <span class="index-cursor" aria-hidden="true" data-index-cursor>›</span>
  <h2 id="work-title" class="prompt-title">~/projects <small>{String(work.length).padStart(2, '0')} side projects</small></h2>
  {work.map(({ id, data }) => (
    <article class="project" id={id} data-project>
      <p class="project-kind">{data.kind}{data.badge && <span class="badge">{data.badge}</span>}</p>
      <div class="project-head">
        <h3 class="display project-title">
          <a href={`/work/${id}/`} aria-label={data.title} style={`view-transition-name: title-${id}`}><span class="project-name" style={`--type-step: ${420 / Array.from(data.title).length}ms`} data-project-name>{Array.from(data.title).map((character, index) => <span class="project-character" style={`--character: ${index}`}>{character}</span>)}</span><span class="project-arrow" aria-hidden="true"> →</span></a>
        </h3>
        <p class="project-when">{data.period}<span>{data.role}</span></p>
      </div>
      <p class="project-summary">{data.summary}</p>
      <p class="project-stack">
        {data.stack.map((tool, index) => <>{index > 0 && <span aria-hidden="true"> / </span>}{tool}</>)}
      </p>
    </article>
  ))}
</section>

<script>
  // One prompt cursor travels between projects: it follows the reading position while
  // scrolling and jumps to whichever project is hovered or focused.
  const section = document.querySelector<HTMLElement>('[data-projects]');
  const cursor = section?.querySelector<HTMLElement>('[data-index-cursor]');

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  if (section && !reducedMotion.matches && 'IntersectionObserver' in window) {
    const titles = [...section.querySelectorAll<HTMLElement>('[data-project-name]')];
    const timers = new Map<HTMLElement, number>();
    const finish = (title: HTMLElement) => {
      clearTimeout(timers.get(title));
      timers.delete(title);
      title.removeAttribute('data-typing');
      observer.unobserve(title);
    };
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const title = entry.target as HTMLElement;
        title.setAttribute('data-typing', 'active');
        observer.unobserve(title);
        timers.set(title, window.setTimeout(() => finish(title), 560));
      }
    }, { rootMargin: '0px 0px -10% 0px' });
    titles.forEach((title) => {
      title.setAttribute('data-typing', 'pending');
      observer.observe(title);
      title.parentElement?.addEventListener('focus', () => finish(title));
      title.parentElement?.addEventListener('click', () => finish(title));
    });
    const finishAll = () => titles.forEach(finish);
    reducedMotion.addEventListener('change', (event) => { if (event.matches) finishAll(); });
    addEventListener('pageswap', finishAll);
    addEventListener('pagehide', finishAll);
    addEventListener('pagereveal', (event) => { if (event.viewTransition) finishAll(); });
  }

  if (section && cursor) {
    const rows = [...section.querySelectorAll<HTMLElement>('[data-project]')];
    let frame = 0;

    const select = (row: HTMLElement) => {
      rows.forEach((item) => item.toggleAttribute('data-active', item === row));
      const title = row.querySelector<HTMLElement>('.project-title')!;
      const offset = title.getBoundingClientRect().top - section.getBoundingClientRect().top;
      cursor.style.transform = `translateY(${offset + title.offsetHeight / 2}px) translateY(-50%)`;
      cursor.setAttribute('data-ready', '');
    };

    const follow = () => {
      frame = 0;
      const line = innerHeight * .38;
      const nearest = rows.reduce((best, row) =>
        Math.abs(row.getBoundingClientRect().top - line) < Math.abs(best.getBoundingClientRect().top - line) ? row : best);
      select(nearest);
    };

    const schedule = () => { if (!frame) frame = requestAnimationFrame(follow); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    rows.forEach((row) => {
      row.addEventListener('pointerenter', () => select(row));
      row.addEventListener('focusin', () => select(row));
    });
    document.fonts.ready.then(schedule);
  }
</script>

<style>
  .projects { position: relative; }

  .index-cursor {
    position: absolute;
    top: 0;
    left: 1.5rem;
    color: var(--accent);
    font: 700 2.6rem/1 var(--font-display);
    text-shadow: 0 0 22px #6d9bff80;
    pointer-events: none;
    opacity: 0;
    transition: transform .45s var(--ease-out), opacity .3s ease;
  }

  .index-cursor[data-ready] { opacity: 1; }

  .prompt-title { margin-bottom: .5rem; }

  .project {
    padding: 2rem 0 2.25rem 2.6rem;
    border-bottom: 1px solid var(--line);
  }

  .project-kind { color: var(--muted); font-size: .875rem; }

  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .project-title {
    margin: .3rem 0 .9rem;
    font-size: clamp(2.75rem, 5vw, 4.1rem);
    line-height: 1.04;
  }

  .project-title a { transition: color .3s ease; }
  .project[data-active] .project-title a,
  .project-title a:focus-visible { color: var(--accent); }

  .project-character { position: relative; }
  /* Keep the caret in the inline tree so typing never changes kerning. */
  .project-character::after {
    content: '';
    position: absolute;
    right: -.04em;
    top: .25em;
    width: 2px;
    height: .75em;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-name[data-typing] .project-character { opacity: 0; }
    .project-name[data-typing='active'] .project-character {
      animation: type-character .001s steps(1, start) both;
      animation-delay: calc(var(--character) * var(--type-step));
    }
    .project-name[data-typing='active'] .project-character::after {
      animation: type-caret var(--type-step) steps(1, end) both;
      animation-delay: calc(var(--character) * var(--type-step));
    }
    .project-name[data-typing='active'] .project-character:last-child::after { animation-duration: calc(var(--type-step) + 140ms); }
  }

  @keyframes type-character { to { opacity: 1; } }
  @keyframes type-caret { from { opacity: 1; } to { opacity: 0; } }

  .project-arrow {
    display: inline-block;
    font-size: .75em;
    transition: transform .4s var(--ease-out);
  }

  .project[data-active] .project-arrow { transform: translateX(.2em); }

  .project-when {
    flex: none;
    color: var(--muted);
    font-size: .875rem;
    text-align: right;
  }

  .project-when span { display: block; margin-top: .3rem; color: var(--accent); }

  .project-summary {
    max-width: 44rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .project-stack {
    margin-top: 1rem;
    color: var(--muted);
    font-size: .8125rem;
  }

  .project-stack span { color: #52617d; }

  @media (max-width: 44rem) {
    .index-cursor { font-size: 1.8rem; }
    .project { padding-left: 1.6rem; }
    .project-head { display: block; }
    .project-when { margin: 0 0 1rem; text-align: left; }
    .project-when span { display: inline; margin-left: .6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-cursor, .project-title a, .project-arrow { transition: none; }
  }
</style>
