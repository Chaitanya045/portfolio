---
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="projects wrap" aria-labelledby="work-title" data-projects>
  <h2 id="work-title" class="prompt-title">Side projects</h2>
  {work.map(({ id, data }) => (
    <article class="project" id={id} data-project>
      <p class="project-kind">{data.kind}{data.badge && <span class="badge">{data.badge}</span>}</p>
      <div class="project-head">
        <h3 class="display project-title">
          <a class="project-link" href={`/work/${id}/`} aria-label={data.title}><span class="project-name" style={`view-transition-name: title-${id}`}>{data.title}</span><span class="project-arrow" aria-hidden="true"> →</span></a>
        </h3>
        <p class="project-when">{data.period}<span>{data.role}</span></p>
      </div>
      <p class="project-summary">{data.summary}</p>
      <p class="project-stack">
        {data.stack.map((tool, index) => <>{index > 0 && <span aria-hidden="true"> / </span>}{tool}</>)}
      </p>
    </article>
  ))}
</section>


<style>
  .prompt-title { margin-bottom: .5rem; }

  .project {
    position: relative;
    padding: 2rem 0 2.25rem;
    border-bottom: 1px solid var(--line);
  }

  /* The title link covers the whole row, so the hover cue and the click target match. */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-link:focus-visible { outline: none; }
  .project-link:focus-visible::after { outline: 2px solid var(--color-accent); outline-offset: 4px; }

  /* Inline-block so the morph into the case study title captures one box. */
  .project-name { display: inline-block; }

  .project-kind { color: var(--muted); font-size: .875rem; }

  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .project-title {
    margin: .3rem 0 .9rem;
    font-size: clamp(2.75rem, 5vw, 4.1rem);
    line-height: 1.04;
  }

  .project-link { transition: color .3s ease; }
  .project:focus-within .project-link { color: var(--accent); }

  .project-arrow {
    display: inline-block;
    font-size: .75em;
    transition: transform .4s var(--ease-out);
  }

  .project:focus-within .project-arrow { transform: translateX(.2em); }

  @media (hover: hover) {
    .project:hover .project-link { color: var(--accent); }
    .project:hover .project-arrow { transform: translateX(.2em); }
  }

  .project-when {
    flex: none;
    color: var(--muted);
    font-size: .875rem;
    text-align: right;
  }

  .project-when span { display: block; margin-top: .3rem; color: var(--accent); }

  .project-summary {
    max-width: 44rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .project-stack {
    margin-top: 1rem;
    color: var(--muted);
    font-size: .8125rem;
  }

  .project-stack span { color: var(--stack-separator); }

  @media (max-width: 44rem) {
    .project-head { display: block; }
    .project-when { margin: 0 0 1rem; text-align: left; }
    .project-when span { display: inline-block; margin-left: .6rem; white-space: nowrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link, .project-arrow { transition: none; }
  }
</style>
