---
import { profile } from '@/data/resume';
---

<section id="contact" class="wrap" aria-labelledby="contact-title"><div class="contact">
  <p class="prompt-title">Contact <small>{profile.location}</small></p>
  <h2 id="contact-title" class="display contact-title" data-reveal>Say hello</h2>
  <div class="contact-row" data-reveal>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
    <button type="button" class="copy-button" data-copy={profile.email} aria-label="Copy email address">
      <svg class="copy-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" /><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" /></svg>
      <svg class="check-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3 8.5 3 3 7-7" /></svg>
      <span data-copy-label>Copy</span>
    </button>
    <a class="contact-resume" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF) <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </div>
</div></section>

<style>
  .contact {
    margin-top: clamp(6rem, 11vw, 9rem);
    padding-top: clamp(3.5rem, 6vw, 5.25rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }

  .contact-title {
    margin: 1.75rem 0 2.25rem;
    font-size: clamp(3.25rem, 8vw, 5.6rem);
    line-height: 1;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1.5rem;
  }

  .contact-email {
    color: var(--accent);
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size .6s var(--ease-out), color .3s ease;
  }

  .contact-email:hover,
  .contact-email:focus-visible { color: var(--accent-soft); background-size: 100% 1px; }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .4rem .8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: none;
    font: inherit;
    font-size: .8125rem;
    cursor: pointer;
    transition: color .2s ease, border-color .2s ease, background-color .2s ease, transform .15s ease;
  }

  .contact-resume {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .4rem .8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: .8125rem;
    transition: color .2s ease, border-color .2s ease;
  }

  .copy-button:hover,
  .contact-resume:hover,
  .contact-resume:focus-visible { color: var(--text); border-color: var(--muted); }
  .copy-button:active { transform: scale(.96); }
  .copy-button[data-copied] { color: var(--bg); border-color: var(--accent); background: var(--accent); }

  .copy-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .check-icon { display: none; }
  .copy-button[data-copied] .copy-icon { display: none; }
  .copy-button[data-copied] .check-icon { display: block; stroke-dasharray: 16; animation: check-draw .35s var(--ease-out) both; }

  @keyframes check-draw { from { stroke-dashoffset: 16; } }

  @media (prefers-reduced-motion: reduce) {
    .contact-email, .copy-button, .contact-resume { transition: none; }
    .copy-button[data-copied] .check-icon { animation: none; }
  }
</style>
