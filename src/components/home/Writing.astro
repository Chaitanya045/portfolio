---
import { getCollection } from 'astro:content';
import { formatDate, readingMinutes } from '@/lib/blog';

// The home page only shows published writing, so local drafts never change its layout.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latest = posts.slice(0, 3);
---

{latest.length > 0 && (
  <section id="writing" class="writing wrap" aria-labelledby="writing-title">
    <h2 id="writing-title" class="prompt-title">~/writing <small>{String(posts.length).padStart(2, '0')} {posts.length === 1 ? 'post' : 'posts'}</small></h2>
    <ol class="writing-list">
      {latest.map((post) => (
        <li data-reveal>
          <a href={`/blog/${post.id}/`} class="writing-item">
            <span class="writing-meta"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time> · {readingMinutes(post)} min read</span>
            <span class="display writing-title">{post.data.title}<span class="writing-arrow" aria-hidden="true"> →</span></span>
            <span class="writing-description">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ol>
    {posts.length > latest.length && <a href="/blog/" class="writing-all">All posts →</a>}
  </section>
)}

<style>
  .writing { padding-top: clamp(5rem, 9vw, 6.5rem); }

  .writing-list { margin: .5rem 0 0; padding: 0; list-style: none; }

  .writing-item {
    display: grid;
    gap: .5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .writing-meta { color: var(--muted); font-size: .875rem; }

  .writing-title {
    max-width: 48rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.15;
    text-wrap: balance;
    transition: color .3s ease;
  }

  .writing-arrow { display: inline-block; transition: transform .4s var(--ease-out); }

  .writing-description { max-width: 44rem; color: var(--body); font-size: 1.0625rem; line-height: 1.75; }

  .writing-item:focus-visible .writing-title { color: var(--accent); }

  @media (hover: hover) {
    .writing-item:hover .writing-title { color: var(--accent); }
    .writing-item:hover .writing-arrow { transform: translateX(.2em); }
  }

  .writing-all { display: inline-block; margin-top: 1.5rem; padding: .4rem 0; color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .writing-title, .writing-arrow { transition: none; }
  }
</style>
