---
import { getCollection } from 'astro:content';
import { experience, jobId, profile } from '@/data/resume';
import { hasPublishedPosts } from '@/lib/blog';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
interface Destination { label: string; hint: string; href: string; external?: boolean }

const destinations: Destination[] = [
  ...work.map(({ id, data }) => ({ label: data.title, hint: 'Project', href: `#${id}` })),
  ...experience.map((job) => ({ label: job.company, hint: 'Experience', href: `#${jobId(job.company)}` })),
  { label: 'Email Chaitanya', hint: 'Contact', href: `mailto:${profile.email}` },
  { label: 'Open résumé', hint: 'PDF', href: profile.resume, external: true },
  ...(await hasPublishedPosts() ? [{ label: 'Read the blog', hint: 'Writing', href: '/blog/' }] : []),
  { label: 'GitHub', hint: 'Profile', href: profile.github, external: true },
  { label: 'LinkedIn', hint: 'Profile', href: profile.linkedin, external: true },
];
---

<dialog class="command" aria-label="Jump to a section" data-command>
  <div class="command-search">
    <span aria-hidden="true">›</span>
    <label class="sr-only" for="command-query">Find a project or section</label>
    <input id="command-query" placeholder="Where would you like to go?" autocomplete="off" spellcheck="false" data-command-query />
    <button type="button" class="command-close" data-command-close>Esc</button>
  </div>
  <nav class="command-results" aria-label="Destinations">
    {destinations.map((item) => (
      <a href={item.href} data-command-item {...(item.external && { target: '_blank', rel: 'noopener noreferrer' })}>
        {item.label}<span>{item.hint}{item.external && ' ↗'}</span>
      </a>
    ))}
    <p class="command-empty" hidden data-command-empty>No matches. Try “Rendro” or “email”.</p>
  </nav>
  <p class="command-foot">↑ ↓ to move · Enter to go · Esc to close</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-command]');
  const query = dialog?.querySelector<HTMLInputElement>('[data-command-query]');

  if (dialog && query) {
    const items = [...dialog.querySelectorAll<HTMLAnchorElement>('[data-command-item]')];
    const empty = dialog.querySelector<HTMLElement>('[data-command-empty]')!;
    const visible = () => items.filter((item) => !item.hidden);

    const filter = () => {
      const term = query.value.trim().toLowerCase();
      items.forEach((item) => { item.hidden = !item.textContent!.toLowerCase().includes(term); });
      empty.hidden = visible().length > 0;
    };

    const open = () => {
      query.value = '';
      filter();
      dialog.showModal();
      query.focus();
    };

    document.querySelectorAll('[data-command-open]').forEach((button) => button.addEventListener('click', open));
    dialog.querySelector('[data-command-close]')!.addEventListener('click', () => dialog.close());
    query.addEventListener('input', filter);
    items.forEach((item) => item.addEventListener('click', () => dialog.close()));

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });

    dialog.addEventListener('keydown', (event) => {
      const options = visible();
      const index = options.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        options[(index + step + options.length) % options.length]?.focus();
      } else if (event.key === 'Enter' && document.activeElement === query) {
        event.preventDefault();
        options[0]?.click();
      }
    });

    // Clicking the backdrop closes the menu.
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  }
</script>

<style>
  .command {
    width: min(38rem, calc(100% - 2rem));
    max-width: none;
    /* Tailwind's reset zeroes dialog margins; restore centring near the top. */
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid #354970;
    border-radius: 14px;
    color: var(--text);
    background: #0c1324;
    box-shadow: 0 30px 120px #000a, 0 0 60px -20px #4f7dff55;
  }

  .command::backdrop { background: #020511bb; backdrop-filter: blur(7px); }

  @media (prefers-reduced-motion: no-preference) {
    .command[open] { animation: command-in .3s var(--ease-out); }
  }

  @keyframes command-in { from { opacity: 0; transform: translateY(-8px) scale(.98); } }

  .command-search {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: 1.25rem 1.35rem;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font: 700 1.4rem var(--font-display);
  }

  .command-search input {
    width: 100%;
    border: 0;
    outline: 0;
    color: var(--text);
    background: none;
    font: 1.0625rem var(--font-sans);
  }

  .command-search input::placeholder { color: var(--muted); }

  .command-close {
    padding: .2rem .45rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    background: none;
    font: .75rem var(--font-mono);
    cursor: pointer;
  }

  .command-results { display: grid; padding: .5rem; }

  .command-results a {
    display: flex;
    justify-content: space-between;
    padding: .8rem 1rem;
    border-radius: 8px;
    font-size: 1rem;
  }

  .command-results a[hidden] { display: none; }

  .command-results a:hover,
  .command-results a:focus-visible { color: #a9c6ff; background: #162749; outline: 0; }

  .command-results span { color: var(--muted); font-size: .8125rem; }

  .command-empty { padding: .9rem 1rem; color: var(--muted); }

  .command-foot {
    padding: .6rem 1.4rem 1rem;
    color: var(--muted);
    font-size: .75rem;
  }
</style>
