---
import { profile } from '@/data/resume';
import { hasPublishedPosts } from '@/lib/blog';

const showBlog = await hasPublishedPosts();
---

<footer class="site-footer">
  <div class="wrap"><div class="footer-inner">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <nav aria-label="Elsewhere">
      <a class="tap" href={profile.resume} target="_blank" rel="noopener">Résumé ↗<span class="sr-only"> (PDF, opens in a new tab)</span></a>
      <a class="tap" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a>
      <a class="tap" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a>
      {showBlog && <a class="tap" href="/blog/">Blog</a>}
    </nav>
  </div></div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    color: var(--muted);
    background: var(--bg);
    font-size: .875rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.75rem 0 2.5rem;
    border-top: 1px solid var(--line);
  }

  nav { display: flex; gap: 2rem; }
  a { transition: color .2s ease; }
  a:hover, a:focus-visible { color: var(--text); }
</style>
