---
// C/S ribbon monogram: an outer chevron C that folds into an inner S as one continuous shape.
interface Props {
  size?: number | string;
  class?: string;
  title?: string;
}

const { size = 40, class: className, title } = Astro.props;
// Each instance needs its own gradient id; the header and footer both render the logo.
const gradientId = `logo-gradient-${Math.random().toString(36).slice(2, 8)}`;
const ribbon = 'M315 150H885V280H382L220 512L382 742H693L668 705H520L384 512L525 310H885V440H593L544 512L587 574H735L945 873H315L60 512Z';
---

<svg
  class:list={['logo', className]}
  width={size}
  height={size}
  viewBox="40 50 925 925"
  fill="none"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <defs>
    <linearGradient id={gradientId} x1="60" y1="150" x2="945" y2="873" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#b9d0ff" />
      <stop offset=".5" stop-color="#7aa7ff" />
      <stop offset="1" stop-color="#4f7dff" />
    </linearGradient>
  </defs>
  <path class="logo-fill" d={ribbon} fill={`url(#${gradientId})`} />
  <path class="logo-outline" d={ribbon} stroke="#b9d0ff" stroke-width="14" stroke-linejoin="round" pathLength="100" />
</svg>

<style>
  .logo {
    overflow: visible;
    transition: transform .45s var(--ease-out), filter .45s ease;
  }

  .logo-outline { opacity: 0; }

  /* Hovering the logo's link nudges the chevron forward and lights it up. */
  :global(a:hover) > .logo,
  :global(a:focus-visible) > .logo {
    transform: translateX(-2px);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--accent-strong) 70%, transparent));
  }

  /* After the hero intro, the ribbon traces its outline and then fills in. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-intro]) .logo-fill { opacity: 0; }
    :global(html[data-intro]) .logo-outline { opacity: 1; stroke-dasharray: 100; stroke-dashoffset: 100; }

    :global(html[data-intro-done]) .logo-outline {
      stroke-dasharray: 100;
      animation: logo-trace 1.1s var(--ease-out) both, logo-outline-out .5s ease 1s both;
    }

    :global(html[data-intro-done]) .logo-fill { animation: logo-fill .6s ease .75s both; }
  }

  @keyframes logo-trace {
    from { opacity: 1; stroke-dashoffset: 100; }
    to { opacity: 1; stroke-dashoffset: 0; }
  }

  @keyframes logo-outline-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes logo-fill {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo { transition: none; }
    :global(a:hover) > .logo { transform: none; }
  }
</style>
