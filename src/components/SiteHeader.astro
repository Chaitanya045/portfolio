---
import Logo from '@/components/Logo.astro';

interface Props {
  /** On the home page the header starts open and borderless over the hero. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;
const path = Astro.url.pathname;
const base = path === '/' ? '' : '/';
const inBlog = path.startsWith('/blog');
const left = [
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#experience`, label: 'Experience' },
];
const right = [
  { href: `${base}#contact`, label: 'Contact' },
  { href: '/blog/', label: 'Blog', current: inBlog },
];
const all = [...left, ...right];
---

<header class="site-header" data-site-header data-over-hero={overHero ? '' : undefined} data-intro-content>
  <nav class="capsule" aria-label="Primary" data-nav>
    <span class="capsule-glow" aria-hidden="true"></span>
    <span class="capsule-light" aria-hidden="true"></span>
    <span class="nav-dot" aria-hidden="true" data-nav-dot></span>

    <ul class="nav-links nav-left">
      {left.map((link) => (
        <li>
          <a href={link.href} class="nav-link" data-nav-link>{link.label}</a>
        </li>
      ))}
    </ul>

    <a href={base || '#top'} class="nav-logo" aria-label="Chaitanya Sanapala, home">
      <Logo size={36} />
    </a>

    <ul class="nav-links nav-right">
      {right.map((link) => (
        <li>
          <a href={link.href} class="nav-link" data-nav-link aria-current={link.current ? 'page' : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>

    <button type="button" class="menu-button" data-menu-button aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span>Menu</span>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <ul>
      {all.map((link, index) => (
        <li style={`--i: ${index}`}><a href={link.href} data-menu-link><span class="kicker">0{index + 1}</span>{link.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const nav = header.querySelector<HTMLElement>('[data-nav]')!;
    const dot = header.querySelector<HTMLElement>('[data-nav-dot]')!;
    const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const menuButton = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    let current = links.find((link) => link.getAttribute('aria-current') === 'page');

    // Open over the hero; once it scrolls away the nav condenses into a floating capsule.
    if (hero && header.hasAttribute('data-over-hero')) {
      new IntersectionObserver(([entry]) => {
        header.toggleAttribute('data-solid', !entry?.isIntersecting);
        requestAnimationFrame(measure);
      }, { rootMargin: '-80px 0px -100% 0px' }).observe(hero);
    } else {
      header.setAttribute('data-solid', '');
    }

    // Each link needs its offset inside the capsule so its text can sample the shared light.
    function measure() {
      const navBox = nav.getBoundingClientRect();
      links.forEach((link) => link.style.setProperty('--lx', `${link.getBoundingClientRect().left - navBox.left}px`));
      placeDot(current);
    }

    // A small dot rests under the current section and glides between links.
    function placeDot(target?: HTMLAnchorElement) {
      if (!target) return dot.removeAttribute('data-visible');
      const navBox = nav.getBoundingClientRect();
      const box = target.getBoundingClientRect();
      dot.style.setProperty('--x', `${box.left - navBox.left + box.width / 2}px`);
      dot.setAttribute('data-visible', '');
    }

    // The light eases toward the pointer each frame, so it trails slightly behind the cursor.
    let lightX = 0;
    let targetX = 0;
    let frame = 0;
    const follow = () => {
      lightX += (targetX - lightX) * .18;
      nav.style.setProperty('--mx', `${lightX}px`);
      frame = Math.abs(targetX - lightX) > .5 ? requestAnimationFrame(follow) : 0;
    };
    function aim(x: number, jump = false) {
      targetX = x;
      if (jump) lightX = x;
      if (!frame) frame = requestAnimationFrame(follow);
    }
    nav.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      aim(event.clientX - nav.getBoundingClientRect().left, true);
      nav.setAttribute('data-lit', '');
    });
    nav.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'mouse') aim(event.clientX - nav.getBoundingClientRect().left);
    });
    nav.addEventListener('pointerleave', () => nav.removeAttribute('data-lit'));

    function markCurrent(link?: HTMLAnchorElement) {
      current = link;
      links.forEach((item) => {
        if (item.getAttribute('aria-current') === 'page') return;
        item.toggleAttribute('aria-current', item === link);
      });
      placeDot(current);
    }

    const sections = links
      .filter((link) => link.hash && link.pathname === location.pathname)
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter(Boolean) as HTMLElement[];
    if (sections.length) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) markCurrent(links.find((link) => link.hash === `#${entry.target.id}`));
        }
      }, { rootMargin: '-45% 0px -50% 0px' });
      sections.forEach((section) => observer.observe(section));
      if (hero) new IntersectionObserver(([entry]) => {
        if (entry?.isIntersecting) markCurrent(undefined);
      }, { rootMargin: '-45% 0px -50% 0px' }).observe(hero);
    }

    // Keyboard focus parks the light on the focused link.
    links.forEach((link) => {
      link.addEventListener('focus', () => {
        if (!link.matches(':focus-visible')) return;
        const navBox = nav.getBoundingClientRect();
        const box = link.getBoundingClientRect();
        aim(box.left - navBox.left + box.width / 2, !nav.hasAttribute('data-lit'));
        nav.setAttribute('data-lit', '');
      });
      link.addEventListener('blur', () => nav.removeAttribute('data-lit'));
    });
    // The capsule animates its size when it condenses; re-measure once that settles.
    nav.addEventListener('transitionend', (event) => { if (event.target === nav) measure(); });
    addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    measure();

    function setMenu(open: boolean) {
      if (!menuButton || !menu) return;
      menuButton.setAttribute('aria-expanded', String(open));
      header!.toggleAttribute('data-menu-open', open);
      menu.hidden = !open;
    }
    menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
    menu?.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuButton.focus();
      }
    });
  }
</script>

<style>
  /* How strongly link text picks up the cursor light; animates in and out with it. */
  @property --glow {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  @property --glow-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: grid;
    justify-items: center;
    gap: .5rem;
    padding: 1rem 1rem 0;
    color: var(--text);
    pointer-events: none;
  }

  .capsule {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    padding: .5rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 999px;
    pointer-events: auto;
    transition:
      padding .6s var(--ease-out),
      column-gap .6s var(--ease-out),
      background-color .4s ease,
      border-color .4s ease,
      box-shadow .4s ease,
      --glow .4s ease;
  }

  /* Condensed: a glassy floating capsule. */
  .site-header[data-solid] .capsule,
  .site-header[data-menu-open] .capsule {
    column-gap: clamp(.25rem, 1.2vw, .75rem);
    padding: .35rem .4rem;
    border-color: color-mix(in srgb, var(--line) 80%, transparent);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    box-shadow: 0 12px 40px -18px #000, inset 0 1px 0 #ffffff0d;
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }

  /* A slow light travels around the capsule's border. */
  .capsule-glow {
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    background: conic-gradient(from var(--glow-angle), transparent 0 72%, #7aa7ff99 86%, #b9d0ff 90%, transparent 96%);
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    opacity: 0;
    pointer-events: none;
    transition: opacity .6s ease;
  }

  .site-header[data-solid] .capsule-glow { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .capsule-glow { animation: glow-orbit 7s linear infinite; }
  }

  @keyframes glow-orbit { to { --glow-angle: 360deg; } }

  .nav-links {
    position: relative;
    z-index: 1;
    display: flex;
    gap: .15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-left { justify-content: flex-end; }
  .nav-right { justify-content: flex-start; }

  .nav-link {
    display: block;
    padding: .55rem 1rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: .875rem;
  }

  .nav-link[aria-current] { color: var(--text); }

  .nav-link:focus-visible { outline-offset: 2px; }

  /* The cursor light: a soft blue glow inside the capsule that trails the pointer. */
  .capsule-light {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(9rem circle at var(--mx, -20rem) 50%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity .4s ease;
  }

  .capsule[data-lit] .capsule-light { opacity: 1; }

  /* Link text samples the same light: brighter where it passes, muted elsewhere. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .nav-link {
      --base: var(--muted);
      color: transparent;
      background: radial-gradient(5.5rem circle at calc(var(--mx, -20rem) - var(--lx, 0px)) 50%, color-mix(in srgb, #ffffff var(--glow), var(--base)), var(--base) 100%) no-repeat;
      background-clip: text;
      -webkit-background-clip: text;
    }

    .nav-link[aria-current] { --base: var(--text); }
  }

  .capsule[data-lit] { --glow: 100%; }

  .nav-dot {
    position: absolute;
    left: 0;
    bottom: .3rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-strong);
    opacity: 0;
    transform: translateX(var(--x, 0)) scale(.4);
    pointer-events: none;
    transition: transform .6s var(--ease-out), opacity .3s ease;
  }

  .nav-dot[data-visible] { opacity: 1; transform: translateX(var(--x, 0)) scale(1); }

  .nav-logo {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    transition: background-color .3s ease;
  }

  .nav-logo:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }

  .menu-button {
    display: none;
    align-items: center;
    gap: .6rem;
    padding: .55rem .9rem;
    border: 0;
    border-radius: 999px;
    color: var(--text);
    background: none;
    font: inherit;
    font-size: .875rem;
    cursor: pointer;
  }

  .menu-icon {
    position: relative;
    width: 16px;
    height: 10px;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform .35s var(--ease-out), top .35s var(--ease-out);
  }

  .menu-icon span:first-child { top: 0; }
  .menu-icon span:last-child { top: calc(100% - 1.5px); }
  .menu-button[aria-expanded='true'] .menu-icon span:first-child { top: calc(50% - .75px); transform: rotate(45deg); }
  .menu-button[aria-expanded='true'] .menu-icon span:last-child { top: calc(50% - .75px); transform: rotate(-45deg); }

  .mobile-menu {
    width: min(100%, 26rem);
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: 0 20px 50px -20px #000;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    pointer-events: auto;
    transform-origin: top center;
  }

  .mobile-menu ul {
    display: grid;
    margin: 0;
    padding: .5rem 1.25rem;
    list-style: none;
  }

  .mobile-menu li + li a { border-top: 1px solid var(--line); }

  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: .85rem 0;
    font-family: var(--font-serif);
    font-size: 1.9rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) { animation: menu-drop .45s var(--ease-out) both; }
    .mobile-menu li { animation: menu-in .45s var(--ease-out) both; animation-delay: calc(80ms + var(--i) * 55ms); }
  }

  @keyframes menu-drop {
    from { opacity: 0; transform: translateY(-8px) scale(.97); }
  }

  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-6px); }
  }

  /* Small screens: the capsule holds the menu button and the logo. */
  @media (max-width: 44rem) {
    .nav-links, .nav-dot, .capsule-light { display: none; }
    .capsule { width: min(100%, 26rem); padding: .35rem .4rem; }
    .menu-button { display: inline-flex; grid-column: 1; grid-row: 1; justify-self: start; }
    .nav-logo { grid-column: 2; grid-row: 1; }
  }

  @media (min-width: 44.01rem) {
    .mobile-menu { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .capsule, .capsule-glow, .capsule-light, .nav-dot, .menu-icon span { transition: none; }
  }
</style>
