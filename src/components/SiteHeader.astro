---
import Logo from '@/components/Logo.astro';
import { profile } from '@/data/resume';

interface Props {
  /** On the home page the header starts transparent over the hero. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;
const base = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: `${base}#contact`, label: 'Contact' },
];
---

<header class="site-header" data-site-header data-over-hero={overHero ? '' : undefined} data-intro-content>
  <nav class="site-nav" aria-label="Primary">
    <div class="nav-left">
      <ul class="nav-links" data-nav-links>
        {links.map((link) => <li><a href={link.href} data-nav-link>{link.label}</a></li>)}
        <li class="nav-indicator" aria-hidden="true" data-nav-indicator></li>
      </ul>
      <button type="button" class="menu-button" data-menu-button aria-expanded="false" aria-controls="mobile-menu">
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
        <span>Menu</span>
      </button>
    </div>

    <a href={base || '#top'} class="nav-logo" aria-label="Chaitanya Sanapala, home">
      <Logo size={42} />
    </a>

    <div class="nav-right">
      <p class="nav-clock" title="Local time in Bangalore">
        <span class="clock-dot" aria-hidden="true"></span>
        <span class="sr-only">Local time in Bangalore: </span>
        <span>BLR</span>
        <time data-clock>IST</time>
      </p>
      <a class="icon-link" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
      <a class="icon-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
      </a>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <ul>
      {links.map((link, index) => (
        <li style={`--i: ${index}`}><a href={link.href} data-menu-link><span class="kicker">0{index + 1}</span>{link.label}</a></li>
      ))}
    </ul>
  </div>
  <span class="scroll-progress" aria-hidden="true"></span>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const indicator = header.querySelector<HTMLElement>('[data-nav-indicator]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const menuButton = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    let current: HTMLAnchorElement | undefined;
    let lastY = scrollY;
    let frame = 0;

    // Transparent over the hero, solid once the hero is behind it.
    if (hero && header.hasAttribute('data-over-hero')) {
      new IntersectionObserver(([entry]) => {
        header.toggleAttribute('data-solid', !entry?.isIntersecting);
      }, { rootMargin: '-64px 0px -100% 0px' }).observe(hero);
    } else {
      header.setAttribute('data-solid', '');
    }

    // Tuck the header away while reading down; bring it back on any scroll up.
    function onScroll() {
      frame = 0;
      const y = scrollY;
      const open = menuButton?.getAttribute('aria-expanded') === 'true';
      header!.toggleAttribute('data-tucked', y > lastY && y > 240 && !open);
      lastY = y;
    }
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(onScroll); }, { passive: true });

    // One underline glides between links: it follows hover and rests on the current section.
    function moveIndicator(target?: HTMLAnchorElement) {
      if (!indicator) return;
      if (!target) return indicator.removeAttribute('data-visible');
      indicator.style.setProperty('--x', `${target.offsetLeft}px`);
      indicator.style.setProperty('--w', `${target.offsetWidth}px`);
      indicator.setAttribute('data-visible', '');
    }
    const sections = links.map((link) => document.getElementById(link.hash.slice(1))).filter(Boolean) as HTMLElement[];
    if (sections.length) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          current = links.find((link) => link.hash === `#${entry.target.id}`);
          links.forEach((link) => link.toggleAttribute('aria-current', link === current));
          moveIndicator(current);
        }
      }, { rootMargin: '-45% 0px -50% 0px' });
      sections.forEach((section) => observer.observe(section));
      if (hero) new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        current = undefined;
        links.forEach((link) => link.removeAttribute('aria-current'));
        moveIndicator();
      }, { rootMargin: '-45% 0px -50% 0px' }).observe(hero);
    }
    links.forEach((link) => link.addEventListener('pointerenter', () => moveIndicator(link)));
    header.querySelector('[data-nav-links]')?.addEventListener('pointerleave', () => moveIndicator(current));
    addEventListener('resize', () => moveIndicator(current));

    function setMenu(open: boolean) {
      if (!menuButton || !menu) return;
      menuButton.setAttribute('aria-expanded', String(open));
      header!.toggleAttribute('data-menu-open', open);
      if (open) menu.hidden = false;
      else menu.hidden = true;
    }
    menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
    menu?.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuButton.focus();
      }
    });

    const clock = header.querySelector<HTMLTimeElement>('[data-clock]');
    if (clock) {
      const format = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });
      const tick = () => {
        const now = new Date();
        clock.textContent = format.format(now);
        clock.dateTime = now.toISOString();
      };
      tick();
      setInterval(tick, 10_000);
    }
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    color: var(--text);
    border-bottom: 1px solid transparent;
    transition: transform .45s var(--ease-out), background-color .35s ease, border-color .35s ease;
  }

  .site-header[data-solid],
  .site-header[data-menu-open] {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }

  .site-header[data-tucked] { transform: translateY(-100%); }

  .site-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 76rem;
    height: 4.25rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav-links {
    position: relative;
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: .875rem;
  }

  .nav-links a {
    display: block;
    padding: .4rem 0;
    color: var(--muted);
    transition: color .2s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current] { color: var(--text); }

  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: var(--w, 0);
    height: 1px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent-strong);
    opacity: 0;
    transform: translateX(var(--x, 0));
    transition: transform .5s var(--ease-out), width .5s var(--ease-out), opacity .25s ease;
  }

  .nav-indicator[data-visible] { opacity: 1; }

  .nav-logo {
    display: grid;
    place-items: center;
    color: var(--accent);
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .35rem;
  }

  .nav-clock {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin-right: .75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .04em;
    font-variant-numeric: tabular-nums;
  }

  .clock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-strong);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-strong) 60%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .clock-dot { animation: clock-pulse 2.4s ease-out infinite; }
  }

  @keyframes clock-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-strong) 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 7px transparent; }
  }

  .icon-link {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--muted);
    transition: color .2s ease, background-color .2s ease, transform .3s var(--ease-out);
  }

  .icon-link:hover {
    color: var(--text);
    background: var(--surface);
    transform: translateY(-2px);
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: .6rem;
    padding: .4rem 0;
    border: 0;
    color: var(--text);
    background: none;
    font: inherit;
    font-size: .875rem;
    cursor: pointer;
  }

  .menu-icon {
    position: relative;
    width: 16px;
    height: 10px;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform .35s var(--ease-out), top .35s var(--ease-out);
  }

  .menu-icon span:first-child { top: 0; }
  .menu-icon span:last-child { top: calc(100% - 1.5px); }
  .menu-button[aria-expanded='true'] .menu-icon span:first-child { top: calc(50% - .75px); transform: rotate(45deg); }
  .menu-button[aria-expanded='true'] .menu-icon span:last-child { top: calc(50% - .75px); transform: rotate(-45deg); }

  .mobile-menu ul {
    display: grid;
    margin: 0;
    padding: .5rem 1.5rem 1.5rem;
    list-style: none;
  }

  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: .9rem 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: 2rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu li { animation: menu-in .45s var(--ease-out) both; animation-delay: calc(var(--i) * 60ms); }
  }

  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
  }

  .scroll-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, #8a2f1c, var(--accent-strong), #ffc293);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header[data-solid] .scroll-progress { opacity: 1; }
      .scroll-progress { animation: progress linear both; animation-timeline: scroll(root); }
    }
  }

  @keyframes progress { to { transform: scaleX(1); } }

  @media (max-width: 52rem) {
    .nav-links { display: none; }
    .menu-button { display: inline-flex; }
    .nav-clock { display: none; }
  }

  @media (min-width: 52.01rem) {
    .mobile-menu { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .nav-indicator, .icon-link, .menu-icon span { transition: none; }
    .icon-link:hover { transform: none; }
  }
</style>
