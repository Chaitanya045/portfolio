---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

// Drafts appear while developing and stay out of production builds.
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const format = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Blog — Chaitanya Sanapala" description="Writing by Chaitanya Sanapala on backend systems, AI pipelines and testing.">
  <SiteHeader />
  <main id="main" class="sheet blog">
    <div class="wrap">
      <div class="section-head">
        <h1 class="serif section-title" data-reveal="title"><span>Blog</span></h1>
        <span class="kicker">({String(posts.length).padStart(2, '0')})</span>
      </div>

      {posts.length ? (
        <ol class="posts">
          {posts.map((post) => (
            <li data-reveal>
              <a href={`/blog/${post.id}/`} class="post" data-cursor="Read post →">
                <time class="kicker" datetime={post.data.publishedAt.toISOString()}>{format(post.data.publishedAt)}</time>
                <span>
                  <span class="serif post-title">{post.data.title}{post.data.draft && <span class="kicker post-draft">draft</span>}</span>
                  <span class="post-description">{post.data.description}</span>
                </span>
                <span class="post-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty" data-reveal>Nothing published yet. Notes on backend systems, AI pipelines and testing are on the way.</p>
      )}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .blog {
    min-height: 70svh;
    padding: 8rem 0 6rem;
  }

  .posts {
    position: relative;
    z-index: 0;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post {
    position: relative;
    display: grid;
    gap: .75rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .post { grid-template-columns: 10rem 1fr auto; align-items: baseline; gap: 2rem; }
  }

  .post::before {
    content: '';
    position: absolute;
    inset: 0 -1.5rem;
    z-index: -1;
    background: linear-gradient(90deg, var(--surface), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .6s var(--ease-out);
  }

  .post:hover::before { transform: scaleX(1); }

  .post-title {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.1;
    transition: color .3s ease;
  }

  .post:hover .post-title { color: var(--accent); }
  .post-draft { padding: .1rem .45rem; border: 1px solid var(--line); border-radius: 999px; }

  .post-description {
    display: block;
    max-width: 40rem;
    margin-top: .5rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .post-arrow {
    color: var(--muted);
    transition: transform .4s var(--ease-out), color .3s ease;
  }

  .post:hover .post-arrow { color: var(--accent); transform: translateX(6px); }

  @media (hover: hover) and (pointer: fine) { .post { cursor: none; } }

  .empty {
    max-width: 34rem;
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .post::before, .post-title, .post-arrow { transition: none; }
    .post:hover .post-arrow { transform: none; }
    .post { cursor: pointer; }
  }
</style>
