---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { formatDate, getPosts } from '@/lib/blog';

const posts = await getPosts();
---

<BaseLayout title="Blog — Chaitanya Sanapala" description="Writing by Chaitanya Sanapala on backend systems, AI pipelines and testing." noindex={!posts.length}>
  <SiteHeader />
  <main id="main" class="sheet blog">
    <div class="wrap blog-wrap">
      <h1 class="prompt-title">~/blog <small>{String(posts.length).padStart(2, '0')} {posts.length === 1 ? 'post' : 'posts'}</small></h1>

      {posts.length ? (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="post">
                <span class="display post-title" style={`view-transition-name: post-title-${post.id}; view-transition-class: post-morph`}>{post.data.title}{post.data.draft && <span class="post-draft">draft</span>}</span>
                <time class="post-date" datetime={post.data.publishedAt.toISOString()} style={`view-transition-name: post-date-${post.id}; view-transition-class: post-morph`}>{formatDate(post.data.publishedAt)}</time>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">Nothing published yet.</p>
      )}

      <a href="/" class="blog-back tap"><span aria-hidden="true">←</span> Back to home</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* One line per post: the title on the left and its date on the right. */
  .blog {
    min-height: 80svh;
    padding: 8rem 0 4rem;
  }

  .blog-wrap { max-width: 56rem; }

  .posts { margin: 1.5rem 0 0; padding: 0; list-style: none; }

  .post {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  /* An accent line draws over the divider, so the date reads as part of the same link. */
  .post::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .45s var(--ease-out);
  }

  .post-title {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.25;
    text-wrap: pretty;
    transition: color .3s ease, transform .35s var(--ease-out);
  }

  /* Pressing a post acknowledges the click at once: the line completes and the title leans in. */
  .post:active::after { transform: scaleX(1); transition-duration: .15s; }
  .post:active .post-title { color: var(--accent); transform: translateX(6px); transition-duration: .15s; }

  .post-date {
    flex: none;
    color: var(--muted);
    font-size: .875rem;
    font-variant-numeric: tabular-nums;
  }

  .post:focus-visible .post-title { color: var(--accent); }
  .post:focus-visible::after { transform: scaleX(1); }

  @media (hover: hover) {
    .post:hover .post-title { color: var(--accent); }
    .post:hover::after { transform: scaleX(1); }
  }

  .post-draft {
    margin-left: .75rem;
    padding: .05rem .5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: 400 .75rem var(--font-sans);
    vertical-align: .2em;
  }

  .empty { margin-top: 2rem; color: var(--body); font-size: 1.0625rem; }

  .blog-back {
    display: block;
    width: fit-content;
    margin: 4rem auto 0;
    padding: .4rem .25rem;
    color: var(--muted);
    font-size: .875rem;
    transition: color .2s ease;
  }

  .blog-back:hover, .blog-back:focus-visible { color: var(--text); }

  @media (max-width: 40rem) {
    .post { gap: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post::after, .post-title, .blog-back { transition: none; }
    .post:active .post-title { transform: none; }
  }
</style>
