---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

// Drafts appear while developing and stay out of production builds.
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const format = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Blog — Chaitanya Sanapala" description="Writing by Chaitanya Sanapala on backend systems, AI pipelines and testing.">
  <SiteHeader />
  <main id="main" class="sheet blog">
    <div class="wrap">
      <div class="section-head">
        <h1 class="display section-title" data-reveal="title"><span>Blog</span></h1>
        <span class="kicker">({String(posts.length).padStart(2, '0')})</span>
      </div>

      {posts.length ? (
        <ol class="posts">
          {posts.map((post) => (
            <li data-reveal>
              <a href={`/blog/${post.id}/`} class="post">
                <time class="kicker" datetime={post.data.publishedAt.toISOString()}>{format(post.data.publishedAt)}</time>
                <span>
                  <span class="display post-title">{post.data.title}{post.data.draft && <span class="kicker post-draft">draft</span>}</span>
                  <span class="post-description">{post.data.description}</span>
                </span>
                <span class="post-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty" data-reveal>Nothing published yet. Notes on backend systems, AI pipelines and testing are on the way.</p>
      )}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .blog {
    min-height: 70svh;
    padding: 8rem 0 6rem;
  }

  .posts {
    position: relative;
    z-index: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .35rem 1.5rem;
    align-items: baseline;
    padding: 1.35rem 0;
    transition: opacity .35s ease;
  }

  .post time { grid-column: 1 / -1; grid-row: 1; }

  /* Hovering one post quietly dims the others. */
  @media (hover: hover) {
    .posts:has(.post:hover) .post:not(:hover) { opacity: .4; }
  }

  .post-title {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    font-size: 1.5rem;
    line-height: 1.2;
    transition: color .3s ease;
  }

  .post:hover .post-title { color: #fff; }
  .post-draft { padding: .1rem .45rem; border: 1px solid var(--line); border-radius: 999px; }

  .post-description {
    display: block;
    margin-top: .35rem;
    color: var(--body);
    line-height: 1.7;
  }

  .post-arrow {
    color: var(--muted);
    transition: transform .4s var(--ease-out), color .3s ease;
  }

  .post:hover .post-arrow { color: var(--accent); transform: translateX(6px); }

  .empty {
    margin-top: 1.5rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .post, .post-title, .post-arrow { transition: none; }
    .post:hover .post-arrow { transform: none; }
  }
</style>
