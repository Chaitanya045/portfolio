---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import MorphWords from '@/components/blog/MorphWords.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { profile } from '@/data/resume';
import { formatDate, getPosts, readingMinutes } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'>; }

const { post } = Astro.props;
const { title, description, publishedAt, tags, draft, canonicalUrl } = post.data;
const { Content } = await render(post);
const minutes = readingMinutes(post);
const source = canonicalUrl ? new URL(canonicalUrl).hostname.replace(/^www\./, '').replace(/\.com$/, '') : null;
const sourceName = source === 'medium' ? 'Medium' : source;

// Structured data lets search engines show the post as an article with its author and date.
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  author: { '@type': 'Person', name: profile.name, url: Astro.site?.href },
  keywords: tags.join(', '),
  mainEntityOfPage: canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={`${title} — ${profile.name}`} description={description} type="article" noindex={draft} canonicalUrl={canonicalUrl}>
  <meta slot="head" property="article:published_time" content={publishedAt.toISOString()} />
  {tags.map((tag) => <meta slot="head" property="article:tag" content={tag} />)}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(article)} />
  <script slot="head" is:inline>
    // Tag arrivals before the first frame so the article can rise in behind the title.
    addEventListener('pagereveal', (event) => event.viewTransition?.types.add('reading'));
  </script>
  <div class="post-progress" aria-hidden="true" hidden></div>
  <header class="sheet post-top">
    <nav class="wrap post-wrap post-nav" aria-label="Post navigation">
      <a href="/" class="tap post-home" aria-label="Chaitanya Sanapala, home"><Logo size={36} /></a>
      <a href="/blog/" class="tap">← All posts</a>
    </nav>
  </header>
  <main id="main" class="sheet post">
    <div class="wrap post-wrap">
      {draft && <p class="kicker post-draft">Draft preview</p>}

      <header class="post-head">
        {tags.length > 0 && <p class="post-tags">{tags.join(' / ')}</p>}
        <h1 class="display post-title"><MorphWords text={title} name={`post-title-${post.id}`} large /></h1>
        <p class="post-meta">
          <time datetime={publishedAt.toISOString()} style={`view-transition-name: post-date-${post.id}; view-transition-class: post-morph`}>{formatDate(publishedAt, 'long')}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          {canonicalUrl && (
            <>
              <span aria-hidden="true">·</span>
              <a class="tap" href={canonicalUrl} target="_blank" rel="noopener">Originally on {sourceName} ↗<span class="sr-only"> (opens in a new tab)</span></a>
            </>
          )}
        </p>
      </header>

      <article class="post-body">
        <Content />
      </article>

      <footer class="post-end">
        {canonicalUrl && (
          <p>
            This post was first published on <a class="tap" href={canonicalUrl} target="_blank" rel="noopener">{sourceName} ↗<span class="sr-only"> (opens in a new tab)</span></a>, where you can leave a response.
          </p>
        )}
        <a href="/blog/" class="post-end-link">← All posts</a>
      </footer>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>('.post-progress');
  const body = document.querySelector<HTMLElement>('.post-body');

  if (progress && body) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const { top, height } = body.getBoundingClientRect();
      const distance = height - window.innerHeight;
      const fraction = distance > 0 ? Math.min(1, Math.max(0, -top / distance)) : Number(top <= 0);
      progress.style.transform = `scaleX(${fraction})`;
      progress.hidden = false;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    addEventListener('pageshow', schedule);
    addEventListener('load', schedule, { once: true });
    document.fonts.ready.then(schedule);
    schedule();
  }
</script>

<style>
  .post-wrap { max-width: 46rem; }

  .post { padding: 2.5rem 0 6rem; }
  .post-top { padding-top: 1.5rem; }

  .post-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font: .9375rem/1.5 var(--font-sans);
  }

  .post-nav a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    padding-block: .25rem;
    color: var(--muted);
  }

  .post-nav a:hover { color: var(--text); }

  /* Shares the header logo's transition name, so it glides here from the centre of the header. */
  .post-home :global(.logo) { view-transition-name: site-logo; }

  .post-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: 2px;
    background: var(--accent);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left;
  }

  .post-draft { margin-top: 2rem; color: var(--accent); }

  .post-head { padding-bottom: 2rem; border-bottom: 1px solid var(--line); }

  .post-tags { color: var(--accent); font: .8125rem/1.5 var(--font-mono); }

  .post-title {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 5vw, 3rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .6rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: .875rem;
  }

  .post-meta a { color: var(--accent); }
  .post-meta a:hover { color: var(--accent-soft); }

  /* Article typography. Markdown output has no classes, so these reach into the rendered body. */
  .post-body {
    margin-top: 2.5rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .post-body :global(:where(p, ul, ol, pre, blockquote, table)) { margin: 0 0 1.35rem; }

  .post-body :global(h2) {
    margin: 3rem 0 1rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .post-body :global(:where(ul, ol)) { padding-left: 1.25rem; }
  .post-body :global(ul) { list-style: disc; }
  .post-body :global(ol) { list-style: decimal; }
  .post-body :global(li) { margin: .35rem 0; padding-left: .35rem; }
  .post-body :global(li::marker) { color: var(--accent); }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-body :global(strong) { color: var(--text); }

  .post-body :global(blockquote) {
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--text);
    font-size: 1.125rem;
  }

  .post-body :global(:not(pre) > code) {
    padding: .1rem .35rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font: .875em var(--font-mono);
  }

  /* Shiki colours the code; the frame matches the site instead of the theme's background. */
  .post-body :global(pre) {
    overflow-x: auto;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background-color: var(--code-bg) !important;
    font: .875rem/1.65 var(--font-mono);
    tab-size: 2;
  }

  .post-body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: .9375rem;
  }

  .post-body :global(:where(th, td)) {
    padding: .7rem 1rem .7rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .post-body :global(th) { color: var(--text); font-weight: 600; }

  .post-end {
    display: grid;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: .9375rem;
    line-height: 1.7;
  }

  .post-end a { color: var(--accent); }
  .post-end p a { text-decoration: underline; text-underline-offset: 4px; }
  .post-end-link { justify-self: start; padding: .4rem 0; }

  @media (max-width: 40rem) {
    .post-body :global(pre) { margin-inline: -1.5rem; border-radius: 0; border-inline: 0; font-size: .8125rem; }
  }
</style>
