---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { getPosts } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'>; }

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Chaitanya Sanapala`} description={post.data.description} type="article" noindex={post.data.draft}>
  <SiteHeader />
  <main id="main" class="sheet post">
    <div class="wrap post-wrap">
      <a href="/blog/" class="kicker post-back tap">← All posts</a>
      {post.data.draft && <p class="kicker post-draft">Draft preview</p>}
      <h1 class="display post-title">{post.data.title}</h1>
      <time datetime={post.data.publishedAt.toISOString()} class="kicker post-date">
        {post.data.publishedAt.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' })}
      </time>
      <article class="post-body">
        <Content />
      </article>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .post-wrap { max-width: 48rem; }

  .post { padding: 8rem 0 6rem; }

  .post-back {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
  }

  .post-back:hover { text-decoration-color: currentColor; }
  .post-draft { margin-top: 2rem; color: var(--accent); }

  .post-title {
    margin-top: 1.5rem;
    font-size: clamp(2.1rem, 5vw, 2.75rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .post-date { display: block; margin-top: 1rem; }

  .post-body {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .post-body :global(h2) {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.25;
  }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
