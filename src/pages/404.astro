---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---

<BaseLayout title="Page not found — Chaitanya Sanapala" description="This page doesn’t exist." noindex>
  <SiteHeader />
  <main id="main" class="sheet missing">
    <div class="wrap">
      <p class="prompt-title">~/404 <small>not found</small></p>
      <h1 class="display missing-title">This page doesn’t exist.</h1>
      <p class="missing-copy">The link may be broken, or the page may have moved.</p>
      <a class="missing-link" href="/">← Back to the home page</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .missing {
    display: flex;
    align-items: center;
    min-height: 80svh;
    padding: 8rem 0 5rem;
  }

  .missing .wrap { width: 100%; }

  .missing-title {
    margin: 1.75rem 0 1.25rem;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.02;
  }

  .missing-copy { color: var(--body); font-size: 1.0625rem; }

  .missing-link {
    display: inline-block;
    margin-top: 2rem;
    padding: .6rem 0;
    color: var(--accent);
  }

  .missing-link:hover, .missing-link:focus-visible { color: var(--accent-soft); }
</style>
