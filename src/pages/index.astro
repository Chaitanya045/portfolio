---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlazeBackground from '@/components/BlazeBackground.astro';
import HeroIntro from '@/components/HeroIntro.astro';
import RoleScroller from '@/components/RoleScroller.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Intro from '@/components/home/Intro.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Experience from '@/components/home/Experience.astro';
import Writing from '@/components/home/Writing.astro';
import Contact from '@/components/home/Contact.astro';
import CommandMenu from '@/components/home/CommandMenu.astro';
import { profile } from '@/data/resume';
import { spring } from 'motion';

// Bake the spring into CSS so Motion adds no browser runtime for this effect.
const nameSpring = String(spring(.45));

// Structured data helps search engines show the name, role and profiles together.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Bangalore', addressCountry: 'IN' },
  sameAs: [profile.github, profile.linkedin],
};
---

<BaseLayout title="Chaitanya Sanapala — Software Engineer" description="Software engineer in Bangalore working across backend development, SaaS quality engineering and AI systems." launchIntro>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <SiteHeader overHero />
  <main id="main">
  <div id="top" class="hero" data-hero data-motion="running">
    <BlazeBackground />
    <HeroIntro />
    <div data-intro-content class="flex min-h-svh items-center justify-center px-6 text-center">
      <div class="hero-title">
        <h1 class="hero-name" data-interactive-name style={`--name-spring: ${nameSpring}`}>
          <span class="hero-name-ink" data-name-ink>CHAITANYA<span class="hero-name-highlight" aria-hidden="true">CHAITANYA</span></span>
        </h1>
        <div class="hero-sub">
          <RoleScroller />
          <ul class="hero-socials" aria-label="Elsewhere">
            <li>
              <a class="hero-social" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
              </a>
            </li>
            <li>
              <a class="hero-social" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <button class="motion-toggle sr-only focus:not-sr-only focus:fixed focus:right-6 focus:bottom-6" data-motion-toggle type="button" aria-label="Pause animations" aria-pressed="false" hidden>
        <svg class="pause-icon" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="2.5" height="8" rx=".5" /><rect x="7.5" y="2" width="2.5" height="8" rx=".5" /></svg>
        <svg class="play-icon" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="m3 1.5 7 4.5-7 4.5z" /></svg>
        <span>Motion</span>
      </button>
    </div>
  </div>
  <div class="sheet sheet-cover">
    <Intro />
    <SelectedWork />
    <Experience />
    <Writing />
    <Contact />
  </div>
  </main>
  <SiteFooter />
  <CommandMenu />
</BaseLayout>

<script>
  const name = document.querySelector<HTMLElement>('[data-interactive-name]');
  const ink = name?.querySelector<HTMLElement>('[data-name-ink]');
  const hero = name?.closest<HTMLElement>('[data-hero]');

  if (name && ink && hero) {
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    const enabled = () => finePointer.matches && !reducedMotion.matches &&
      !document.hidden && !document.documentElement.hasAttribute('data-intro') &&
      hero.dataset.motion !== 'paused';

    function reset() {
      cancelAnimationFrame(frame);
      frame = 0;
      delete name!.dataset.interacting;
      ink!.style.setProperty('--name-x', '0px');
      ink!.style.setProperty('--name-y', '0px');
    }

    function paint() {
      frame = 0;
      if (!enabled()) return reset();
      const box = name!.getBoundingClientRect();
      const x = Math.max(0, Math.min(box.width, pointerX - box.left));
      const y = Math.max(0, Math.min(box.height, pointerY - box.top));
      name!.dataset.interacting = 'true';
      ink!.style.setProperty('--name-x', `${(x / box.width - .5) * 10}px`);
      ink!.style.setProperty('--name-y', `${(y / box.height - .5) * 6}px`);
      ink!.style.setProperty('--light-x', `${x}px`);
      ink!.style.setProperty('--light-y', `${y}px`);
    }

    function move(event: PointerEvent) {
      if (event.pointerType === 'touch' || event.buttons || !enabled()) return reset();
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = requestAnimationFrame(paint);
    }

    name.addEventListener('pointerenter', move);
    name.addEventListener('pointermove', move);
    name.addEventListener('pointerleave', reset);
    name.addEventListener('pointercancel', reset);
    name.addEventListener('pointerdown', reset);
    finePointer.addEventListener('change', reset);
    reducedMotion.addEventListener('change', reset);
    document.addEventListener('visibilitychange', reset);
    hero.addEventListener('blaze:motionchange', reset);

    function cleanup() {
      reset();
      name!.removeEventListener('pointerenter', move);
      name!.removeEventListener('pointermove', move);
      name!.removeEventListener('pointerleave', reset);
      name!.removeEventListener('pointercancel', reset);
      name!.removeEventListener('pointerdown', reset);
      finePointer.removeEventListener('change', reset);
      reducedMotion.removeEventListener('change', reset);
      document.removeEventListener('visibilitychange', reset);
      hero!.removeEventListener('blaze:motionchange', reset);
    }
    window.addEventListener('pagehide', (event) => { if (!event.persisted) cleanup(); });
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>

<style>
  .hero-title { position: relative; }

  /* Roles and social links hang below the name without shifting it off centre. */
  .hero-sub {
    position: absolute;
    top: calc(100% + clamp(1rem, 2vw, 1.75rem));
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100vw - 48px), 40rem);
  }

  .hero-socials {
    display: flex;
    justify-content: center;
    gap: .75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-social {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid #9fb2d626;
    border-radius: 50%;
    color: #a9b6cf;
    background: #0c142940;
    transition: color .2s ease, border-color .2s ease, background-color .2s ease, transform .35s var(--ease-out), box-shadow .35s ease;
  }

  .hero-social:hover,
  .hero-social:focus-visible {
    color: #e6ecf7;
    border-color: #7aa7ff;
    background: #12234a80;
    box-shadow: 0 0 18px #4f7dff59;
    transform: translateY(-3px);
  }

  /* Once the hero intro has finished, the icons fade in slowly, one after the other.
     The list items animate so the links keep their own hover lift. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-intro]) .hero-socials li { opacity: 0; }
    :global(html[data-intro-done]) .hero-socials li { animation: social-in 2.2s cubic-bezier(.45, 0, .25, 1) .5s both; }
    :global(html[data-intro-done]) .hero-socials li + li { animation-delay: .95s; }
  }

  @keyframes social-in {
    from { opacity: 0; transform: translateY(10px); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-social { transition: none; }
    .hero-social:hover, .hero-social:focus-visible { transform: none; }
  }

  /* The page body fades up out of the hero's glow rather than starting on a hard edge. */
  .sheet-cover {
    margin-top: -10rem;
    padding-top: 10rem;
    background: linear-gradient(to bottom, transparent, var(--bg) 10rem);
  }

  .hero-name {
    color: #7aa7ff;
    font-family: 'Outfit', 'Segoe UI', sans-serif;
    font-size: clamp(2.75rem, 7.5vw, 7rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: .04em;
  }

  .hero-name-ink {
    display: inline-block;
    position: relative;
    transform: translate3d(var(--name-x, 0px), var(--name-y, 0px), 0);
    transition: transform .6s cubic-bezier(.22, 1, .36, 1);
  }

  @supports (transition-timing-function: linear(0, 1)) {
    .hero-name-ink { transition: transform var(--name-spring); }
  }

  .hero-name-highlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    color: transparent;
    background: radial-gradient(ellipse 140px 100px at var(--light-x, 50%) var(--light-y, 50%), #dce8ff, #a9c6ff80 45%, transparent 100%);
    background-clip: text;
    -webkit-background-clip: text;
    opacity: 0;
    transition: opacity .3s ease;
  }

  .hero-name[data-interacting] .hero-name-highlight { opacity: 1; }

  :global([data-hero][data-motion='paused']) .hero-name-ink,
  :global([data-hero][data-motion='paused']) .hero-name-highlight {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .hero-name-ink { transform: none; transition: none; }
    .hero-name-highlight { display: none; }
  }
</style>
