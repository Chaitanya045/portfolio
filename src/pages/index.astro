---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlazeBackground from '@/components/BlazeBackground.astro';
import HeroIntro from '@/components/HeroIntro.astro';
import RoleScroller from '@/components/RoleScroller.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Intro from '@/components/home/Intro.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Experience from '@/components/home/Experience.astro';
import Contact from '@/components/home/Contact.astro';
import CommandMenu from '@/components/home/CommandMenu.astro';
import { profile } from '@/data/resume';

// Structured data helps search engines show the name, role and profiles together.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Bangalore', addressCountry: 'IN' },
  sameAs: [profile.github, profile.linkedin, profile.x],
};
---

<BaseLayout title="Chaitanya Sanapala — Software Engineer" description="Software engineer in Bangalore building backend pipelines, and the tests that catch them breaking." launchIntro>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <SiteHeader overHero />
  <main id="main">
  <div id="top" class="hero" data-hero data-motion="running">
    <BlazeBackground />
    <HeroIntro />
    <div data-intro-content class="flex min-h-svh items-center justify-center px-6 text-center">
      <div class="hero-title">
        <h1 class="hero-name">
          <span class="hero-name-ink">CHAITANYA</span>
        </h1>
        <div class="hero-sub">
          <RoleScroller />
          <ul class="hero-socials" aria-label="Elsewhere">
            <li>
              <a class="hero-social" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
              </a>
            </li>
            <li>
              <a class="hero-social" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
                <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
              </a>
            </li>
            <li>
              <a class="hero-social" href={profile.x} target="_blank" rel="noopener noreferrer" aria-label="X (opens in a new tab)">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z" /></svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <button class="motion-toggle sr-only focus:not-sr-only focus:fixed focus:right-6 focus:bottom-6" data-motion-toggle type="button" aria-label="Pause animations" aria-pressed="false" hidden>
        <svg class="pause-icon" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="2.5" height="8" rx=".5" /><rect x="7.5" y="2" width="2.5" height="8" rx=".5" /></svg>
        <svg class="play-icon" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="m3 1.5 7 4.5-7 4.5z" /></svg>
        <span>Motion</span>
      </button>
    </div>
  </div>
  <div class="sheet sheet-cover">
    <Intro />
    <SelectedWork />
    <Experience />
    <Contact />
  </div>
  </main>
  <SiteFooter />
  <CommandMenu />
</BaseLayout>


<style>
  .hero-title { position: relative; }

  /* Roles and social links hang below the name without shifting it off centre. */
  .hero-sub {
    position: absolute;
    top: calc(100% + clamp(1rem, 2vw, 1.75rem));
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100vw - 48px), 40rem);
  }

  .hero-socials {
    display: flex;
    justify-content: center;
    gap: .75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Solid, blurred discs with full-strength icons, so they hold their own over the animated hero. */
  .hero-social {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in srgb, var(--control-border) 38%, transparent);
    border-radius: 50%;
    color: var(--text);
    background: color-mix(in srgb, var(--control-bg) 70%, transparent);
    box-shadow: 0 6px 20px -10px color-mix(in srgb, var(--hero-shade) 90%, transparent), inset 0 1px 0 color-mix(in srgb, var(--text) 8%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: color .2s ease, border-color .2s ease, background-color .2s ease, transform .35s var(--ease-out), box-shadow .35s ease;
  }

  /* On hover the disc fills with the theme's name colour from the centre, and the icon flips to
     the background colour so it reads as a cut-out. */
  .hero-social { position: relative; overflow: hidden; isolation: isolate; }

  .hero-social::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--hero-name);
    transform: scale(0);
    transition: transform .4s var(--ease-out);
  }

  .hero-social:hover,
  .hero-social:focus-visible {
    color: var(--bg);
    border-color: var(--hero-name);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent-strong) 50%, transparent);
    transform: translateY(-3px);
  }

  .hero-social:hover::before,
  .hero-social:focus-visible::before { transform: scale(1); }

  /* Once the hero intro has finished, the icons fade up together with the nav links.
     The list items animate so the links keep their own hover lift. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-intro]) .hero-socials li { opacity: 0; }
    :global(html[data-intro-done]) .hero-socials li { animation: social-in .7s var(--ease-out) 1.3s both; }
  }

  @keyframes social-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-social { transition: none; }
    .hero-social:hover, .hero-social:focus-visible { transform: none; }
    .hero-social::before { transition: none; }
  }

  /* The page body fades up out of the hero's glow rather than starting on a hard edge. */
  .sheet-cover {
    margin-top: -10rem;
    padding-top: 10rem;
    background: linear-gradient(to bottom, transparent, var(--bg) 10rem);
  }

  .hero-name {
    color: var(--hero-name);
    font-family: 'Outfit', 'Segoe UI', sans-serif;
    font-size: clamp(2.75rem, 7.5vw, 7rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: .04em;
  }

  /* The name is filled with the theme's own shades. */
  .hero-name-ink {
    display: inline-block;
    background: linear-gradient(100deg, var(--accent-pale), var(--hero-name) 45%, var(--accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* High-contrast modes ignore background images, so fall back to solid system text. */
  @media (forced-colors: active) {
    .hero-name-ink { background: none; -webkit-text-fill-color: CanvasText; }
  }
</style>
