---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  launchIntro?: boolean;
}

const { title, description = 'Projects, case studies, and writing by Chaitanya.', launchIntro = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
    {launchIntro && (
      <script is:inline>
        (() => {
          // Decide before the first paint so the hero never flashes behind the intro.
          const root = document.documentElement;
          const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
          if (motion.matches) return;

          root.style.setProperty('--intro-line-scale', String(88 / window.innerWidth));
          root.dataset.intro = 'playing';
          let timeout;
          function finish() {
            delete root.dataset.intro;
            root.style.removeProperty('--intro-line-scale');
            clearTimeout(timeout);
            document.removeEventListener('animationend', onAnimationEnd);
            window.removeEventListener('keydown', finish);
            window.removeEventListener('pointerdown', finish);
            motion.removeEventListener('change', finish);
          }
          function onAnimationEnd(event) {
            if (event.target instanceof Element && event.target.hasAttribute('data-intro-line')) finish();
          }
          document.addEventListener('animationend', onAnimationEnd);
          window.addEventListener('keydown', finish, { once: true });
          window.addEventListener('pointerdown', finish, { once: true });
          motion.addEventListener('change', finish, { once: true });
          // Also reveal the page if CSS animation events fail to arrive.
          timeout = setTimeout(finish, 2200);
        })();
      </script>
    )}
  </head>
  <body class="font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:p-3">Skip to content</a>
    <slot />
    <script>
      import '@/scripts/interactions';
    </script>
  </body>
</html>
